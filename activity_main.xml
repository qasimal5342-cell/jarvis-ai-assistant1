<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:background="#080B10" android:layout_width="match_parent" android:layout_height="match_parent">
 <TextView android:id="@+id/title" android:text="J A R V I S" android:textColor="#00D9FF" android:textSize="30sp" android:textStyle="bold" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/status" android:text="Ready" android:textColor="#FFFFFF" android:textSize="16sp" android:gravity="center" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <Button android:id="@+id/voice" android:text="START VOICE COMMAND" android:layout_width="match_parent" android:layout_height="60dp"/>
 <Button android:id="@+id/access" android:text="ENABLE SCREEN CONTROL" android:layout_width="match_parent" android:layout_height="55dp"/>
 <Button android:id="@+id/screen" android:text="ENABLE SCREEN VISION" android:layout_width="match_parent" android:layout_height="55dp"/>
 <EditText android:id="@+id/command" android:hint="Type command..." android:textColor="#FFFFFF" android:hintTextColor="#888888" android:background="#111822" android:padding="14dp" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="60dp"/>
 <Button android:id="@+id/run" android:text="RUN COMMAND" android:layout_width="match_parent" android:layout_height="55dp"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"><TextView android:id="@+id/log" android:textColor="#DDDDDD" android:textSize="14sp" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
</LinearLayout>
